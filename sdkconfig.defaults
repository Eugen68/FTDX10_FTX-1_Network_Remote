# ESP-IDF Project Minimal Configuration
CONFIG_IDF_TARGET="esp32s3"
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
# Partitions: partitions.csv (16 MB flash, two 4 MB OTA app slots, NVS where it always was). Changing the
# table needs one write over the cable (tools/scrie_firmware.bat option 3 keeps the settings); OTA cannot.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# A new firmware that does not confirm itself (see ota_confirm_running) is rolled back on the next reboot
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Wi-Fi / TCP tuning for real-time audio streaming
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
# Send buffer 64 KB: the throughput of one TCP stream is about send buffer / round-trip time, and with
# 16 KB and a 50-80 ms Wi-Fi round trip it was right at the 192 kB/s the stereo audio needs (the stream
# buffer then stayed full and overflowed). With PSRAM the LwIP buffers live there. On a board without PSRAM
# this costs up to 64 KB of internal RAM while a stream is slow: lower it to 16384 for such a board.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_WND_DEFAULT=16384
CONFIG_ESP_WIFI_TX_BA_WIN=16
CONFIG_ESP_WIFI_RX_BA_WIN=16
# The HTTPS server uses max_open_sockets = 10 and the HTTP server reserves 3 sockets internally,
# so LwIP needs at least 13 (the default of 10 makes httpd_ssl_start() fail and the firmware abort)
# + the plain HTTP redirect server on port 80 (2 sockets + its own 3), with room to spare
CONFIG_LWIP_MAX_SOCKETS=24
CONFIG_LWIP_SO_LINGER=y
# Faster TLS handshake (ECDSA is computed in software)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Primary console on UART0 (USB-to-UART / hardware pins) with secondary on USB Serial/JTAG
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
# Memory-corruption hardening: stack canaries in every function that has a local array or address-taken
# variable, and guard words around heap blocks that are checked when a block is freed
CONFIG_COMPILER_STACK_CHECK_MODE_STRONG=y
CONFIG_HEAP_POISONING_LIGHT=y
# The serial config menu runs on the main task and keeps several large buffers on its stack
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Internal RAM is tight (heap minimum dropped to ~2 KB in service): allocate each TLS connection's 16 KB RX / 4 KB TX
# buffers only while data is in flight instead of for the whole lifetime of every open connection.
# The server certificate and key must stay loaded, so the "free config data" options stay off.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
# CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA is not set
# CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT is not set
# PSRAM (ESP32-S3-N16R8 and similar: 8 MB octal PSRAM). Large allocations (TLS record buffers, Wi-Fi / LwIP
# buffers) go to PSRAM and leave the internal RAM to the USB host, the tasks' stacks and DMA. A board without
# PSRAM (or with quad PSRAM) still boots: the PSRAM is then simply not used and everything stays internal.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# USB audio: more isochronous transfers in flight (6 x 8 packets = 48 ms instead of 3 x 3 = 9 ms). With
# only 9 ms, a short delay of the USB tasks (Wi-Fi shares core 0) lost packets: 46,373 Hz arrived of
# the radio's 48,000, heard as crackles, and the browser's playout delay drained into gaps.
CONFIG_UAC_NUM_ISOC_URBS=6
CONFIG_UAC_NUM_PACKETS_PER_URB=8
# UAC driver buffer between the USB host and the stream's reader: 32 KB = about 170 ms of 48 kHz stereo
# (it is allocated in internal RAM by the driver, so not larger)
CONFIG_AUDIO_RING_BUFFER_SIZE=32768
# Configuration descriptors up to 2 KB: the FTDX10's USB audio codec has one larger than the default 256
# bytes ("Configuration descriptor larger than control transfer max length", its hub port then disabled).
# Each attached device gets a control buffer of this size (5 devices: 10 KB).
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=2048

# Authenticated same-origin control socket for remote PTT.
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y

# Device HTTPS identity
CONFIG_MBEDTLS_X509_CREATE_C=y
CONFIG_MBEDTLS_X509_CRT_WRITE_C=y
# CONFIG_MBEDTLS_X509_CSR_WRITE_C is not set
